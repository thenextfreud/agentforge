# Database Query Server — Environment Configuration

# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/example_db

# Comma-separated list of allowed tables, or "*" for all tables (default: *)
ALLOWED_TABLES=*

# Maximum number of rows returned per query (default: 1000)
MAX_ROWS=1000

# Query timeout in milliseconds (default: 30000)
QUERY_TIMEOUT_MS=30000
