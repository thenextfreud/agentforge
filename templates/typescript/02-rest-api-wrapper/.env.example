# REST API Wrapper — Environment Configuration

# Base URL of the REST API to wrap (required)
API_BASE_URL=https://jsonplaceholder.typicode.com

# API key for authentication (optional — leave empty if API doesn't require auth)
API_KEY=

# Header name to send the API key in (default: Authorization)
# For Bearer tokens, set this to "Authorization" and include "Bearer " prefix in API_KEY
API_KEY_HEADER=Authorization

# Request timeout in milliseconds (default: 10000)
REQUEST_TIMEOUT_MS=10000

# Maximum retry attempts for failed requests (default: 3)
MAX_RETRIES=3
