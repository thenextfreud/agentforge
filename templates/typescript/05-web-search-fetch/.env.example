# Web Search & Fetch — Environment Configuration

# Search provider to use (default: duckduckgo)
# Options: duckduckgo, brave, tavily, serpapi
SEARCH_PROVIDER=duckduckgo

# API keys for search providers (only needed for the selected provider)
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPAPI_KEY=

# User-Agent string for HTTP requests (default: AgentForge-MCP/1.0)
USER_AGENT=AgentForge-MCP/1.0

# Maximum content length for fetched pages in characters (default: 50000)
MAX_CONTENT_LENGTH=50000

# Request timeout in milliseconds (default: 15000)
REQUEST_TIMEOUT_MS=15000
