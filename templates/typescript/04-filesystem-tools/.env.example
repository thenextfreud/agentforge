# Filesystem Tools — Environment Configuration

# Root directory of the sandbox (required).
# All file operations are restricted to this directory and its subdirectories.
SANDBOX_ROOT=/tmp/sandbox

# Comma-separated list of allowed file extensions, or "*" for all (default: *)
# Example: txt,md,json,js,ts,html,css,csv,yaml,yml,xml
ALLOWED_EXTENSIONS=*

# Maximum file size in megabytes for read/write operations (default: 10)
MAX_FILE_SIZE_MB=10

# If true, only read operations are allowed — write_file is disabled (default: false)
READ_ONLY=false
