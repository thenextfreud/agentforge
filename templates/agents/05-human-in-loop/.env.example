# Required: OpenAI API key for LLM
OPENAI_API_KEY=sk-your-api-key-here

# Model to use (default: gpt-4o-mini)
MODEL=gpt-4o-mini

# MCP server to connect to (default: hello-world stdio server)
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=tsx,../../typescript/01-hello-world-stdio/src/index.ts

# Automatically approve "safe" tools without asking (default: true)
# When false, ALL tool calls require human approval
AUTO_APPROVE_SAFE=true
