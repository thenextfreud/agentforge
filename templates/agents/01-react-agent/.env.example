# Required: OpenAI API key for LLM reasoning
OPENAI_API_KEY=sk-your-api-key-here

# Model to use for reasoning (default: gpt-4o-mini)
MODEL=gpt-4o-mini

# MCP server to connect to (default: hello-world stdio server)
# These are passed to StdioClientTransport — the command and args
# to launch the MCP server process.
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=tsx,../../typescript/01-hello-world-stdio/src/index.ts

# Maximum ReAct loop iterations before giving up (default: 10)
MAX_ITERATIONS=10
