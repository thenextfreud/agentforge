# Required: OpenAI API key for LLM
OPENAI_API_KEY=sk-your-api-key-here

# Model to use (default: gpt-4o-mini)
MODEL=gpt-4o-mini

# MCP RAG server to connect to (default: rag-knowledge-server)
# Point this to any RAG MCP server that provides a "search" or "query" tool
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=../../python/06-rag-knowledge-server/server.py

# Maximum number of retrieved chunks to use as context (default: 5)
MAX_CHUNKS=5
