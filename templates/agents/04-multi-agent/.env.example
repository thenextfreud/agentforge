# Required: OpenAI API key for LLM
OPENAI_API_KEY=sk-your-api-key-here

# Model to use (default: gpt-4o-mini)
MODEL=gpt-4o-mini

# --- Worker MCP Server Configurations ---
# Each worker has its own MCP server connection.
# Environment variable pattern: MCP_SERVER_<WORKER>_COMMAND and MCP_SERVER_<WORKER>_ARGS

# Research Worker — uses web-search MCP server
MCP_SERVER_RESEARCH_COMMAND=npx
MCP_SERVER_RESEARCH_ARGS=tsx,../../typescript/05-web-search-fetch/src/index.ts

# Code Worker — uses filesystem MCP server
MCP_SERVER_CODE_COMMAND=npx
MCP_SERVER_CODE_ARGS=tsx,../../typescript/04-filesystem-tools/src/index.ts

# Data Worker — uses database MCP server
MCP_SERVER_DATA_COMMAND=npx
MCP_SERVER_DATA_ARGS=tsx,../../typescript/03-database-query-server/src/index.ts

# Note: Workers with missing MCP server config will be skipped.
# The coordinator will only assign subtasks to available workers.
