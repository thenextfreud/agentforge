# OAuth issuer URL (any OIDC provider: Auth0, Okta, Clerk, Cognito)
# Example Auth0:  https://YOUR_DOMAIN/
# Example Cognito: https://cognito-idp.REGION.amazonaws.com/USER_POOL_ID
OAUTH_ISSUER=https://your-issuer.example.com/

# JWKS URL. If omitted, derived from OAUTH_ISSUER as:
#   <OAUTH_ISSUER>/.well-known/jwks.json
JWKS_URL=

# Comma-separated scopes that every token must contain
REQUIRED_SCOPES=mcp:tools

# Optional: the audience claim your token must contain (your API identifier).
# Leave empty to skip audience verification.
OAUTH_AUDIENCE=

# HTTP server
HOST=0.0.0.0
PORT=8080

# Rate limiting: max requests per minute per token
RATE_LIMIT_PER_MINUTE=60

# JWKS cache TTL in seconds
JWKS_CACHE_TTL=600
