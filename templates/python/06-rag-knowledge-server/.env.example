# Embedding provider: "local" (sentence-transformers) or "openai"
EMBEDDING_PROVIDER=local

# OpenAI settings (only used when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local embedding model (only used when EMBEDDING_PROVIDER=local)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Vector store: "memory" or "chroma"
VECTOR_STORE=memory
CHROMA_PERSIST_DIR=./chroma_data

# Search
DEFAULT_TOP_K=5
