# SaaS API base URL (the API you are wrapping)
SAAS_API_URL=https://api.projectmanager.example.com

# OAuth2 client credentials for server-to-server auth
SAAS_CLIENT_ID=
SAAS_CLIENT_SECRET=
SAAS_TOKEN_URL=https://auth.projectmanager.example.com/oauth/token
# Optional scope requested during the token exchange
SAAS_API_SCOPE=

# Webhook signature verification (HMAC-SHA256 shared secret)
WEBHOOK_SECRET=

# HTTP client tuning
MAX_RETRIES=3
REQUEST_TIMEOUT=30
RETRY_BASE_DELAY=1
DEFAULT_PAGE_SIZE=50
